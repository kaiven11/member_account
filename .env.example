# Member Manager 环境变量 (全部可选, 不设也能跑, 默认端口 4002)

# 服务端口
# MM_PORT=4002

# 数据文件路径 (默认: 项目目录下 data.json; 文件不存在时自动创建空库)
# MM_DATA=./data.json

# ── 支付链路校验的可选数据源 key ──
# madleets.me 的 Supabase anon key (免费 BIN 查询, 默认内置公开 key, 失效后可在此覆盖)
# MADLEETS_KEY=

# NeutrinoAPI (8 位 BIN 查询, 需免费注册 https://neutrinoapi.com/signup/)
# NEUTRINO_UID=your-user-id
# NEUTRINO_KEY=your-api-key
